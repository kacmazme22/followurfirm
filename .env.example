# Copy this file to .env and fill in real values. NEVER commit the real .env.

# --- AI provider selection ---
# "noop" = pure rule-based categorization, zero LLM calls (safest zero-cost default)
# "groq" = free-tier Groq API for Turkish summarization / dedup judgment calls
AI_PROVIDER=noop
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- SMTP (Gmail free account + App Password) ---
# Generate an App Password at https://myaccount.google.com/apppasswords
# (requires 2FA enabled on the Google account). Do NOT use your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Runtime ---
ENVIRONMENT=local
DRY_RUN=false
